{
  "name": "pak-split-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "server",
    "mobile"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:mobile": "npm run start --workspace mobile --",
    "build": "npm run build --workspace server",
